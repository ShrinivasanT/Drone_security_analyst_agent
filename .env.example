# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=drone_security
POSTGRES_USER=drone
POSTGRES_PASSWORD=drone_pass
DATABASE_URL=postgresql+asyncpg://drone:drone_pass@postgres/drone_security

# --- MinIO (S3-compatible blob storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=drone-frames

# --- VLM / LLM / Embeddings ---
# Used by analyze_frame (vision), reason_decide (reasoning), and embedder (text-embedding-3-small)
OPENAI_API_KEY=
# Optional: set if using Claude vision instead of / alongside GPT-4o for analyze_frame
ANTHROPIC_API_KEY=
