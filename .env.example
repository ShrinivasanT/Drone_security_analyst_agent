# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=drone_security
POSTGRES_USER=drone
POSTGRES_PASSWORD=drone_pass
DATABASE_URL=postgresql+asyncpg://drone:drone_pass@postgres/drone_security

# --- MinIO (S3-compatible blob storage) ---
# Host ports are remapped to 9100/9101 in docker-compose.yml to avoid colliding with
# another MinIO already running on this machine. Container-internal ports remain 9000/9001.
#
# MINIO_ENDPOINT is the boto3 endpoint — set to whichever address the caller can reach:
#   - host-side scripts (Stages 2, 6 ingest_runner):   http://localhost:9100
#   - backend container (Stage 3 onward):              http://minio:9000  (override in compose)
# MINIO_PUBLIC_ENDPOINT is always host-reachable; it's what gets baked into stored
# blob_urls so the React frontend (browser-side) can render frames via <img src=...>.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9100
MINIO_PUBLIC_ENDPOINT=http://localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=drone-frames

# --- Source video clips (simulated drone feed) ---
# Directory containing .mp4 clips used as the simulated drone feed. Gitignored.
# Default points at the UCF-Crime "Normal Videos for Event Recognition" copy — see docs/video_sources.md.
VIDEO_SOURCE_DIR=videos/Normal_Videos_for_Event_Recognition/Normal_Videos_for_Event_Recognition
# Sampling cadence in seconds of video-time (one drone snapshot every N s).
VIDEO_SAMPLE_INTERVAL_SECONDS=2.0

# Base URL of the running FastAPI backend that data/ingest_runner.py POSTs frames to.
BACKEND_URL=http://localhost:8000

# --- VLM / LLM / Embeddings ---
# Vision (analyze_frame) + reasoning (reason_decide) run on GROQ. OpenAI is reserved for
# embeddings only and is NOT used for chat/vision unless LLM_ALLOW_OPENAI_CHAT=true.
#   auto   = prefer Groq if GROQ_API_KEY set, else OpenAI (only if chat fallback enabled)
#   groq   = force Groq first
#   openai = force OpenAI first (only takes effect if LLM_ALLOW_OPENAI_CHAT=true)
LLM_PROVIDER=groq
# Allow OpenAI as a chat/vision provider/fallback. Default false → Groq-only for chat.
LLM_ALLOW_OPENAI_CHAT=false

# Groq (OpenAI-compatible chat/vision API). Groq has NO embeddings endpoint.
GROQ_API_KEY=
# Optional model overrides (provider-aware defaults otherwise):
#   Groq:   GROQ_VLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#           GROQ_TEXT_MODEL=llama-3.3-70b-versatile
#   OpenAI: OPENAI_VLM_MODEL=gpt-4o   OPENAI_TEXT_MODEL=gpt-4o-mini
# VLM_MODEL / REASONING_MODEL force a specific model for the active provider.

# OpenAI — used for EMBEDDINGS only (and chat only if LLM_ALLOW_OPENAI_CHAT=true).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings provider (Groq has none):
#   auto   = OpenAI if OPENAI_API_KEY set, else local hashing fallback (1536-dim)
#   openai = force OpenAI text-embedding-3-small
#   local  = force the dependency-free hashing fallback
EMBEDDING_PROVIDER=auto
