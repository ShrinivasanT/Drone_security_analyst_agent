# Environment
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/build/

# Docker volumes (bind-mounted local data, if any)
pg_data/
minio_data/

# Source video clips — large binaries, do not commit (document sources/download
# instructions in docs/video_sources.md). The clips live in videos/ (top-level)
# because a lowercase data/ directory holds the Python package on case-insensitive
# filesystems and would collide with a capital-D dataset directory.
videos/
Data/
data/videos/
*.mp4
*.mov
*.avi
*.mkv

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
